@* Lyrics for the current track as a scrolling list. Synced lyrics highlight the
   current line and keep it centred (see js/lyrics.js); auto-scroll pauses for a
   few seconds while the user scrolls. Tapping a synced line seeks there when this
   dashboard is controlling the active device. Plain lyrics just scroll. *@

@inject PlaybackController Player
@inject LyricsService Lyrics
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_track is not null)
{
    <section class="lyrics-panel">
        @switch (_state)
        {
            case LoadState.Loading:
                <p class="lyrics-status">Looking for lyrics…</p>
                break;

            case LoadState.Error:
                <div class="lyrics-status">
                    <p>@_error</p>
                    <button class="pill-button" @onclick="RetryAsync">Try again</button>
                </div>
                break;

            case LoadState.NotFound:
                <p class="lyrics-status">No lyrics found for this track.</p>
                break;

            case LoadState.Loaded when _lyrics is { IsSynced: true } synced:
                <div class="lyrics-scroll" @ref="_scrollContainer">
                    @for (var i = 0; i < synced.SyncedLines.Count; i++)
                    {
                        var index = i;
                        var line = synced.SyncedLines[i];

                        <p class="lyrics-line @LineClass(index) @(Player.CanControl ? "seekable" : null)"
                           data-index="@index"
                           @key="index"
                           @onclick="() => SeekToLineAsync(line)">
                            @(string.IsNullOrWhiteSpace(line.Text) ? "♪" : line.Text)
                        </p>
                    }
                </div>
                break;

            case LoadState.Loaded when _lyrics is { HasPlainLyrics: true } plain:
                <div class="lyrics-scroll plain">@plain.PlainLyrics</div>
                break;

            case LoadState.Loaded when _lyrics is { IsInstrumental: true }:
                <p class="lyrics-status">♪ Instrumental</p>
                break;

            default:
                <p class="lyrics-status">No lyrics found for this track.</p>
                break;
        }

        @if (_lyrics is not null)
        {
            <p class="lyrics-credit">Lyrics from @_lyrics.Source</p>
        }
    </section>
}

@code {
    private enum LoadState { Loading, Loaded, NotFound, Error }

    // Show each line a touch early: the position estimate trails real playback slightly,
    // and it reads better to see a line just as it starts.
    private const int LeadMs = 250;
    private static readonly TimeSpan TickInterval = TimeSpan.FromMilliseconds(200);

    private readonly CancellationTokenSource _lifetimeCts = new();
    private CancellationTokenSource? _loadCts;

    private SpotifyTrack? _track;
    private string? _trackKey;
    private LyricsResult? _lyrics;
    private LoadState _state;
    private string? _error;

    private int _currentLine = -1;

    private bool _scrollPending;
    private bool _scrollForce; // jump straight there (new track / seek), even if the user just scrolled

    private ElementReference _scrollContainer;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        Player.StateChanged += OnPlayerStateChanged;
        SyncWithPlayback();
        _ = TickAsync(_lifetimeCts.Token);
    }

    private void OnPlayerStateChanged() => _ = InvokeAsync(() =>
    {
        SyncWithPlayback();
        StateHasChanged();
    });

    /// <summary>Starts a lookup when the track changes and keeps the highlighted line current.</summary>
    private void SyncWithPlayback()
    {
        var track = Player.Playback?.Item;

        if (track is null)
        {
            _loadCts?.Cancel();
            _track = null;
            _trackKey = null;
            _lyrics = null;
            return;
        }

        var key = LyricsService.GetTrackKey(track);
        if (key != _trackKey)
        {
            _track = track;
            _trackKey = key;
            _ = LoadAsync(track);
        }

        UpdateCurrentLine();
    }

    private async Task LoadAsync(SpotifyTrack track)
    {
        _loadCts?.Cancel();
        var cts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _loadCts = cts;

        _lyrics = null;
        _error = null;
        _currentLine = -1;

        if (Lyrics.TryGetCached(track, out var cached))
        {
            ApplyResult(cached);
            return;
        }

        _state = LoadState.Loading;
        StateHasChanged();

        try
        {
            var result = await Lyrics.GetLyricsAsync(track, cts.Token);

            if (cts.IsCancellationRequested)
                return;

            ApplyResult(result);
        }
        catch (OperationCanceledException)
        {
            return; // Track changed or component disposed.
        }
        catch (LyricsProviderException ex)
        {
            if (cts.IsCancellationRequested)
                return;

            _state = LoadState.Error;
            _error = ex.Message;
        }

        StateHasChanged();
    }

    private void ApplyResult(LyricsResult? result)
    {
        _lyrics = result;
        _state = result is null ? LoadState.NotFound : LoadState.Loaded;

        _currentLine = -1;
        UpdateCurrentLine();
        _scrollPending = true;
        _scrollForce = true;
    }

    private Task RetryAsync() => _track is null ? Task.CompletedTask : LoadAsync(_track);

    /// <returns>True if the highlighted line changed.</returns>
    private bool UpdateCurrentLine()
    {
        if (_state != LoadState.Loaded || _lyrics is not { IsSynced: true } lyrics)
            return false;

        var index = lyrics.GetLineIndexAt(Player.EstimatedProgressMs + LeadMs);
        if (index == _currentLine)
            return false;

        _currentLine = index;
        _scrollPending = true;
        return true;
    }

    /// <summary>Checks the position 5×/s but only re-renders when the line actually changes.</summary>
    private async Task TickAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TickInterval);

            while (await timer.WaitForNextTickAsync(ct))
            {
                if (Player.Playback?.IsPlaying == true && UpdateCurrentLine())
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Disposed.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollPending || _state != LoadState.Loaded || _lyrics is not { IsSynced: true })
            return;

        var force = _scrollForce;
        _scrollPending = false;
        _scrollForce = false;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/lyrics.js");
            await _module.InvokeVoidAsync("scrollToLine", _scrollContainer, _currentLine, force);
        }
        catch (JSException)
        {
            // Scrolling is cosmetic; ignore failures.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task SeekToLineAsync(LyricsLine line)
    {
        if (!Player.CanControl)
            return;

        // The tap counts as user interaction (which pauses auto-scroll), so force the
        // scroll for the render triggered by the seek's optimistic update.
        _scrollForce = true;

        await Player.SeekAsync(line.TimeMs);
    }

    private string? LineClass(int index) =>
        index == _currentLine ? "current"
        : index < _currentLine ? "past"
        : null;

    public async ValueTask DisposeAsync()
    {
        Player.StateChanged -= OnPlayerStateChanged;
        _lifetimeCts.Cancel();
        _loadCts?.Cancel();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
