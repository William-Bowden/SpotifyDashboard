@* Lyrics for the current track, shown one page at a time. Pages are sized to fit
   the available height (see js/lyrics.js). Synced lyrics highlight the current
   line and turn to its page automatically; swiping or the pager buttons flip
   pages manually (auto-follow pauses for a few seconds afterwards). Tapping a
   synced line seeks there when this dashboard is controlling the active device. *@

@inject PlaybackController Player
@inject LyricsService Lyrics
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_track is not null)
{
    <section class="lyrics-panel">
        @switch (_state)
        {
            case LoadState.Loading:
                <p class="lyrics-status">Looking for lyrics…</p>
                break;

            case LoadState.Error:
                <div class="lyrics-status">
                    <p>@_error</p>
                    <button class="pill-button" @onclick="RetryAsync">Try again</button>
                </div>
                break;

            case LoadState.NotFound:
                <p class="lyrics-status">No lyrics found for this track.</p>
                break;

            case LoadState.Loaded when _lyrics is { IsSynced: true } synced:
                <div class="lyrics-pages" @ref="_pagesContainer">
                    @for (var i = 0; i < synced.SyncedLines.Count; i++)
                    {
                        var index = i;
                        var line = synced.SyncedLines[i];

                        <p class="lyrics-line @LineClass(index) @(Player.CanControl ? "seekable" : null)"
                           data-index="@index"
                           @key="index"
                           @onclick="() => SeekToLineAsync(line)">
                            @(string.IsNullOrWhiteSpace(line.Text) ? "♪" : line.Text)
                        </p>
                    }
                    <div class="lyrics-spacer" aria-hidden="true"></div>
                </div>
                break;

            case LoadState.Loaded when _plainLines.Length > 0:
                <div class="lyrics-pages plain" @ref="_pagesContainer">
                    @for (var i = 0; i < _plainLines.Length; i++)
                    {
                        <p class="lyrics-line @(string.IsNullOrWhiteSpace(_plainLines[i]) ? "gap" : null)"
                           data-index="@i"
                           @key="i">
                            @_plainLines[i]
                        </p>
                    }
                    <div class="lyrics-spacer" aria-hidden="true"></div>
                </div>
                break;

            case LoadState.Loaded when _lyrics is { IsInstrumental: true }:
                <p class="lyrics-status">♪ Instrumental</p>
                break;

            default:
                <p class="lyrics-status">No lyrics found for this track.</p>
                break;
        }

        @if (_lyrics is not null)
        {
            <div class="lyrics-footer">
                <span class="lyrics-credit">Lyrics from @_lyrics.Source</span>

                @if (HasPages && _pageCount > 1)
                {
                    <div class="lyrics-pager">
                        <button class="icon-button"
                                disabled="@(_page <= 0)"
                                aria-label="Previous page"
                                @onclick="() => FlipAsync(-1)">
                            <Icon Name="chevron-up" Size="22" />
                        </button>

                        <span class="lyrics-page-count">@(_page + 1) / @_pageCount</span>

                        <button class="icon-button"
                                disabled="@(_page >= _pageCount - 1)"
                                aria-label="Next page"
                                @onclick="() => FlipAsync(1)">
                            <Icon Name="chevron-down" Size="22" />
                        </button>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private enum LoadState { Loading, Loaded, NotFound, Error }

    // Show each line a touch early: the position estimate trails real playback slightly,
    // and it reads better to see a line just as it starts.
    private const int LeadMs = 250;
    private static readonly TimeSpan TickInterval = TimeSpan.FromMilliseconds(200);

    private readonly CancellationTokenSource _lifetimeCts = new();
    private CancellationTokenSource? _loadCts;

    private SpotifyTrack? _track;
    private string? _trackKey;
    private LyricsResult? _lyrics;
    private string[] _plainLines = [];
    private LoadState _state;
    private string? _error;

    private int _currentLine = -1;

    // Paging state, mirrored from js/lyrics.js.
    private int _page;
    private int _pageCount = 1;
    private bool _layoutPending; // new lines rendered: recompute pages
    private bool _showLinePending; // current line changed: maybe turn the page
    private bool _showLineForce;

    private ElementReference _pagesContainer;
    private IJSObjectReference? _module;
    private DotNetObjectReference<LyricsPanel>? _selfRef;

    private bool HasPages =>
        _state == LoadState.Loaded && (_lyrics is { IsSynced: true } || _plainLines.Length > 0);

    protected override void OnInitialized()
    {
        Player.StateChanged += OnPlayerStateChanged;
        SyncWithPlayback();
        _ = TickAsync(_lifetimeCts.Token);
    }

    private void OnPlayerStateChanged() => _ = InvokeAsync(() =>
    {
        SyncWithPlayback();
        StateHasChanged();
    });

    /// <summary>Starts a lookup when the track changes and keeps the highlighted line current.</summary>
    private void SyncWithPlayback()
    {
        var track = Player.Playback?.Item;

        if (track is null)
        {
            _loadCts?.Cancel();
            _track = null;
            _trackKey = null;
            _lyrics = null;
            _plainLines = [];
            return;
        }

        var key = LyricsService.GetTrackKey(track);
        if (key != _trackKey)
        {
            _track = track;
            _trackKey = key;
            _ = LoadAsync(track);
        }

        UpdateCurrentLine();
    }

    private async Task LoadAsync(SpotifyTrack track)
    {
        _loadCts?.Cancel();
        var cts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        _loadCts = cts;

        _lyrics = null;
        _plainLines = [];
        _error = null;
        _currentLine = -1;

        if (Lyrics.TryGetCached(track, out var cached))
        {
            ApplyResult(cached);
            return;
        }

        _state = LoadState.Loading;
        StateHasChanged();

        try
        {
            var result = await Lyrics.GetLyricsAsync(track, cts.Token);

            if (cts.IsCancellationRequested)
                return;

            ApplyResult(result);
        }
        catch (OperationCanceledException)
        {
            return; // Track changed or component disposed.
        }
        catch (LyricsProviderException ex)
        {
            if (cts.IsCancellationRequested)
                return;

            _state = LoadState.Error;
            _error = ex.Message;
        }

        StateHasChanged();
    }

    private void ApplyResult(LyricsResult? result)
    {
        _lyrics = result;
        _state = result is null ? LoadState.NotFound : LoadState.Loaded;

        _plainLines = result is { IsSynced: false, HasPlainLyrics: true }
            ? result.PlainLyrics!.Replace("\r\n", "\n").Trim().Split('\n')
            : [];

        _currentLine = -1;
        UpdateCurrentLine();

        _page = 0;
        _pageCount = 1;
        _layoutPending = true;
    }

    private Task RetryAsync() => _track is null ? Task.CompletedTask : LoadAsync(_track);

    /// <returns>True if the highlighted line changed.</returns>
    private bool UpdateCurrentLine()
    {
        if (_state != LoadState.Loaded || _lyrics is not { IsSynced: true } lyrics)
            return false;

        var index = lyrics.GetLineIndexAt(Player.EstimatedProgressMs + LeadMs);
        if (index == _currentLine)
            return false;

        _currentLine = index;
        _showLinePending = true;
        return true;
    }

    /// <summary>Checks the position 5×/s but only re-renders when the line actually changes.</summary>
    private async Task TickAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TickInterval);

            while (await timer.WaitForNextTickAsync(ct))
            {
                if (Player.Playback?.IsPlaying == true && UpdateCurrentLine())
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Disposed.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasPages || (!_layoutPending && !_showLinePending))
            return;

        var layout = _layoutPending;
        var force = _showLineForce;
        _layoutPending = false;
        _showLinePending = false;
        _showLineForce = false;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/lyrics.js");
            _selfRef ??= DotNetObjectReference.Create(this);

            var info = layout
                ? await _module.InvokeAsync<int[]?>("layout", _pagesContainer, _currentLine, _selfRef)
                : await _module.InvokeAsync<int[]?>("showLine", _pagesContainer, _currentLine, force);

            ApplyPageInfo(info);
        }
        catch (JSException)
        {
            // Paging is cosmetic; the lines are still rendered.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task FlipAsync(int delta)
    {
        if (_module is null)
            return;

        try
        {
            ApplyPageInfo(await _module.InvokeAsync<int[]?>("flip", _pagesContainer, delta));
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Called from JS after a swipe, or when a resize changes the page count.</summary>
    [JSInvokable]
    public void OnLyricsPageChanged(int page, int count) =>
        _ = InvokeAsync(() => ApplyPageInfo([page, count]));

    private void ApplyPageInfo(int[]? info)
    {
        if (info is not [var page, var count] || (page == _page && count == _pageCount))
            return;

        _page = page;
        _pageCount = Math.Max(count, 1);
        StateHasChanged();
    }

    private async Task SeekToLineAsync(LyricsLine line)
    {
        if (!Player.CanControl)
            return;

        // Make sure the page follows the seek even if the user flipped pages recently.
        _showLineForce = true;

        await Player.SeekAsync(line.TimeMs);
    }

    private string? LineClass(int index) =>
        index == _currentLine ? "current"
        : index < _currentLine ? "past"
        : null;

    public async ValueTask DisposeAsync()
    {
        Player.StateChanged -= OnPlayerStateChanged;
        _lifetimeCts.Cancel();
        _loadCts?.Cancel();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _pagesContainer);
                await _module.DisposeAsync();
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
