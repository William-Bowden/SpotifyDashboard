@* Seek bar plus previous / play-pause / next.
   Purely presentational: the parent decides which device commands go to. *@

<div class="playback-controls">

    <div class="seek">
        <input type="range"
               class="slider seek-bar"
               style="--pct: @Percent(DisplayPositionMs, DurationMs)"
               min="0"
               max="@Math.Max(DurationMs, 1)"
               step="1000"
               value="@DisplayPositionMs"
               disabled="@(Disabled || !CanSeek || DurationMs <= 0)"
               aria-label="Seek"
               @oninput="OnSeekInput"
               @onchange="OnSeekCommitAsync" />

        <div class="seek-times">
            <span>@FormatTime(DisplayPositionMs)</span>
            <span>@FormatTime(DurationMs)</span>
        </div>
    </div>

    <div class="transport">
        <button class="icon-button transport-button"
                disabled="@(Disabled || !CanSkipPrevious)"
                aria-label="Previous track"
                @onclick="OnPrevious">
            <Icon Name="previous" Size="30" />
        </button>

        <button class="play-button"
                disabled="@(Disabled || (IsPlaying ? !CanPause : !CanResume))"
                aria-label="@(IsPlaying ? "Pause" : "Play")"
                @onclick="OnPlayPause">
            <Icon Name="@(IsPlaying ? "pause" : "play")" Size="30" />
        </button>

        <button class="icon-button transport-button"
                disabled="@(Disabled || !CanSkipNext)"
                aria-label="Next track"
                @onclick="OnNext">
            <Icon Name="next" Size="30" />
        </button>
    </div>
</div>

@code {
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public int ProgressMs { get; set; }
    [Parameter] public int DurationMs { get; set; }
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool CanPause { get; set; } = true;
    [Parameter] public bool CanResume { get; set; } = true;
    [Parameter] public bool CanSkipNext { get; set; } = true;
    [Parameter] public bool CanSkipPrevious { get; set; } = true;
    [Parameter] public bool CanSeek { get; set; } = true;

    [Parameter] public EventCallback OnPlayPause { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback<int> OnSeek { get; set; }

    // While the user drags the slider, show their position instead of the
    // last-known playback position so refreshes don't fight the drag.
    private int? _dragPositionMs;

    private int DisplayPositionMs => Math.Clamp(_dragPositionMs ?? ProgressMs, 0, Math.Max(DurationMs, 0));

    private void OnSeekInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var ms))
            _dragPositionMs = ms;
    }

    private async Task OnSeekCommitAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var ms))
        {
            _dragPositionMs = ms;
            await OnSeek.InvokeAsync(ms);
        }

        _dragPositionMs = null;
    }

    /// <summary>CSS percentage for the filled part of a slider track.</summary>
    internal static string Percent(int value, int max) =>
        max <= 0 ? "0%" : FormattableString.Invariant($"{Math.Clamp(value * 100.0 / max, 0, 100):0.##}%");

    private static string FormatTime(int ms)
    {
        var t = TimeSpan.FromMilliseconds(Math.Max(ms, 0));
        return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
    }
}
