@* Small inline SVG icon set (24×24 grid). Filled glyphs for transport controls,
   stroked outlines for everything else. Colour comes from `currentColor`. *@

<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "play":
            <path fill="currentColor" d="M8 5.14v13.72a1 1 0 0 0 1.53.85l10.98-6.86a1 1 0 0 0 0-1.7L9.53 4.29A1 1 0 0 0 8 5.14z" />
            break;

        case "pause":
            <rect fill="currentColor" x="6" y="4.5" width="4" height="15" rx="1.2" />
            <rect fill="currentColor" x="14" y="4.5" width="4" height="15" rx="1.2" />
            break;

        case "next":
            <path fill="currentColor" d="M5 5.6v12.8a1 1 0 0 0 1.53.85L16 13.3V18a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-1a1 1 0 0 0-1 1v4.7L6.53 4.75A1 1 0 0 0 5 5.6z" />
            break;

        case "previous":
            <path fill="currentColor" d="M19 5.6v12.8a1 1 0 0 1-1.53.85L8 13.3V18a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4.7l9.47-5.95A1 1 0 0 1 19 5.6z" />
            break;

        case "volume":
            <path fill="currentColor" d="M3 9.5v5a1 1 0 0 0 1 1h3l4.4 3.67A1 1 0 0 0 13 18.4V5.6a1 1 0 0 0-1.6-.77L7 8.5H4a1 1 0 0 0-1 1z" />
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16.5 8.8a4.5 4.5 0 0 1 0 6.4M19.2 6a8.5 8.5 0 0 1 0 12" />
            break;

        case "volume-mute":
            <path fill="currentColor" d="M3 9.5v5a1 1 0 0 0 1 1h3l4.4 3.67A1 1 0 0 0 13 18.4V5.6a1 1 0 0 0-1.6-.77L7 8.5H4a1 1 0 0 0-1 1z" />
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16.5 9.5l5 5M21.5 9.5l-5 5" />
            break;

        case "lyrics":
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="2.5" width="6" height="11" rx="3" />
                <path d="M5.5 10.5a6.5 6.5 0 0 0 13 0M12 17v4M8.5 21h7" />
            </g>
            break;

        case "chevron-down":
            <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
            break;

        case "chevron-up":
            <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" />
            break;

        case "chevron-left":
            <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" />
            break;

        case "library":
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4.5 3.5v17M9.5 3.5v17M14 4l6 16.5" />
            break;

        case "heart":
            <path fill="currentColor" d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4 7.4 4c2 0 3.6 1.1 4.6 2.6C13 5.1 14.6 4 16.6 4c3.5 0 5.8 3.6 4.6 7.1-1.7 4.8-9.2 9.4-9.2 9.4z" />
            break;

        case "refresh":
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M20.5 12a8.5 8.5 0 1 1-2.5-6M20.5 3.5V8H16" />
            break;

        case "close":
            <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
            break;

        case "check":
            <path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7.5" />
            break;

        case "logout":
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 16.5L14.5 12 10 7.5M14.5 12H3.5" />
            break;

        case "computer":
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="4" width="19" height="12.5" rx="2" />
                <path d="M8 20.5h8M12 16.5v4" />
            </g>
            break;

        case "smartphone":
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <rect x="6.5" y="2.5" width="11" height="19" rx="2.5" />
                <path d="M11 18h2" />
            </g>
            break;

        case "tv":
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="5" width="19" height="12.5" rx="2" />
                <path d="M7 21h10" />
            </g>
            break;

        case "cast":
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M2.5 16.5a4.5 4.5 0 0 1 4.5 4.5M2.5 12.5a8.5 8.5 0 0 1 8.5 8.5M2.5 8.5V6a2 2 0 0 1 2-2h15a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H15" />
            break;

        case "car":
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3.5 17.5v-4.2l2-5.3a2 2 0 0 1 1.87-1.3h9.26a2 2 0 0 1 1.87 1.3l2 5.3v4.2zM3.5 13.5h17" />
                <path d="M6 17.5v2M18 17.5v2" />
            </g>
            break;

        case "game":
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="7" width="19" height="11" rx="5.5" />
                <path d="M7.5 10.5v4M5.5 12.5h4M15 11.5h.01M17.5 13.5h.01" />
            </g>
            break;

        case "speaker":
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <rect x="5.5" y="2.5" width="13" height="19" rx="2.5" />
                <circle cx="12" cy="14" r="3.5" />
                <path d="M12 7h.01" />
            </g>
            break;

        default:
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5.5l11-2V16" />
                <circle cx="6.5" cy="18" r="2.5" />
                <circle cx="17.5" cy="16" r="2.5" />
            </g>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "music";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string? Class { get; set; }

    /// <summary>Maps a Spotify Connect device type to an icon name.</summary>
    public static string ForDeviceType(string? type) => type?.ToLowerInvariant() switch
    {
        "computer" => "computer",
        "smartphone" or "tablet" => "smartphone",
        "tv" => "tv",
        "castvideo" or "castaudio" => "cast",
        "automobile" => "car",
        "gameconsole" => "game",
        "speaker" or "avr" or "stb" or "audiodongle" => "speaker",
        _ => "speaker"
    };
}
