@* Now playing: artwork, track info, progress and controls. Laid out by CSS grid
   (see .now-playing in dashboard.css) so the same markup works stacked, compact
   (when lyrics are open) and side by side in landscape.
   Reads everything from PlaybackController; a 1-second UI tick advances the
   progress bar locally between polls (no extra API calls). *@

@inject PlaybackController Player
@implements IDisposable

@if (Player.Playback is { } playback)
{
    <section class="now-playing">
        <div class="np-art">
            @if (GetArtworkUrl(playback.Item) is { } artUrl)
            {
                <img src="@artUrl" alt="Album artwork for @playback.Item!.Album!.Name" />
            }
            else
            {
                <div class="np-art-placeholder"><Icon Name="music" Size="56" /></div>
            }
        </div>

        <div class="np-meta">
            @if (playback.Item is { } track)
            {
                <div class="np-title" title="@track.Name">@track.Name</div>
                <div class="np-artist" title="@track.ArtistNames">@track.ArtistNames</div>
            }
            else
            {
                <div class="np-title">@DescribeNonTrack(playback.CurrentlyPlayingType)</div>
            }
        </div>

        <div class="np-controls">
            @ControlsOrTransfer
        </div>
    </section>
}
else
{
    <section class="np-idle">
        <div class="np-idle-icon"><Icon Name="music" Size="40" /></div>
        <p class="np-idle-title">Nothing playing</p>
        <p class="player-hint">Start something in Spotify on any of your devices.</p>
        @ControlsOrTransfer
    </section>
}

@code {
    private readonly CancellationTokenSource _cts = new();

    private RenderFragment ControlsOrTransfer => __builder =>
    {
        if (Player.SelectedDevice is not { } selected)
        {
            @* Selecting is display-only; it never sends anything to Spotify. *@
            if (Player.ActiveDevice is { IsControllable: true } active)
            {
                <div class="np-notice">
                    <p class="player-hint">Playing on <strong>@active.Name</strong></p>
                    <button class="pill-button" @onclick="() => Player.SelectDevice(active.Id)">
                        Control @active.Name
                    </button>
                </div>
            }
            else if (Player.Playback is not null)
            {
                <p class="player-hint">Choose a device below to control playback.</p>
            }
        }
        else if (Player.NeedsTransfer)
        {
            @* Only an explicit tap here moves playback to another device. *@
            <div class="np-notice">
                @if (Player.ActiveDevice is { } active)
                {
                    <p class="player-hint">Playing on <strong>@active.Name</strong></p>
                }

                <button class="pill-button primary"
                        disabled="@Player.IsCommandBusy"
                        @onclick="Player.TransferToSelectedAsync">
                    @(Player.ActiveDevice is null ? $"Start playback on {selected.Name}" : $"Move playback to {selected.Name}")
                </button>
            </div>
        }
        else
        {
            <PlaybackControls IsPlaying="@(Player.Playback?.IsPlaying ?? false)"
                              ProgressMs="Player.EstimatedProgressMs"
                              DurationMs="@(Player.Playback?.Item?.DurationMs ?? 0)"
                              Disabled="@(!Player.CanControl)"
                              CanPause="@(!Player.IsDisallowed("pausing"))"
                              CanResume="@(!Player.IsDisallowed("resuming"))"
                              CanSkipNext="@(!Player.IsDisallowed("skipping_next"))"
                              CanSkipPrevious="@(!Player.IsDisallowed("skipping_prev"))"
                              CanSeek="@(!Player.IsDisallowed("seeking"))"
                              OnPlayPause="Player.TogglePlayPauseAsync"
                              OnNext="Player.NextAsync"
                              OnPrevious="Player.PreviousAsync"
                              OnSeek="Player.SeekAsync" />

            <VolumeControl Volume="@(Player.Playback?.Device?.VolumePercent ?? selected.VolumePercent)"
                           Supported="@(Player.Playback?.Device?.SupportsVolume ?? selected.SupportsVolume)"
                           Disabled="@(!Player.CanControl)"
                           OnVolumeChanged="Player.SetVolumeAsync" />
        }
    };

    protected override void OnInitialized()
    {
        Player.StateChanged += OnPlayerStateChanged;
        _ = TickAsync(_cts.Token);
    }

    private void OnPlayerStateChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Re-renders once a second while playing so the progress bar advances.</summary>
    private async Task TickAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

            while (await timer.WaitForNextTickAsync(ct))
            {
                if (Player.Playback?.IsPlaying == true)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    /// <summary>Spotify lists images largest first; the largest (~640px) stays sharp on high-DPI phones.</summary>
    internal static string? GetArtworkUrl(SpotifyTrack? track) =>
        track?.Album?.Images
            .OrderByDescending(i => i.Width ?? 0)
            .FirstOrDefault(i => !string.IsNullOrEmpty(i.Url))
            ?.Url;

    /// <summary>Smallest image, for the blurred backdrop (cheap to decode; detail is blurred away).</summary>
    internal static string? GetBackdropUrl(SpotifyTrack? track) =>
        track?.Album?.Images
            .Where(i => !string.IsNullOrEmpty(i.Url))
            .OrderBy(i => i.Width ?? int.MaxValue)
            .FirstOrDefault()
            ?.Url;

    private static string DescribeNonTrack(string? type) => type switch
    {
        "ad" => "Advertisement",
        "episode" => "Podcast episode",
        _ => "Unknown content"
    };

    public void Dispose()
    {
        Player.StateChanged -= OnPlayerStateChanged;
        _cts.Cancel();
    }
}
